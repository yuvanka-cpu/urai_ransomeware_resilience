{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urai:ransomware:scenario-config:1.0",
  "title": "Ransomware Scenario Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "seed",
    "industry",
    "site",
    "asset_set",
    "lifecycle_timing",
    "event_family_parameters"
  ],
  "properties": {
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "integer"
    },
    "industry": {
      "type": "string",
      "enum": [
        "energy",
        "petrochemical"
      ]
    },
    "site": {
      "type": "string",
      "minLength": 1
    },
    "asset_set": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lifecycle_timing": {
      "type": "object"
    },
    "event_family_parameters": {
      "type": "object"
    },
    "intended_labels": {
      "type": "object"
    }
  }
}
